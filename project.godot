config_version=5

[application]
config/name="帝國戰記 SRPG"
config/use_custom_user_dir=true
config/custom_user_dir_name="EmpireTactics"
run/main_scene="res://camp.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

G="*res://game.gd"

[debug]
file_logging/enable_file_logging.pc=false

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=4

[rendering]
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
anti_aliasing/quality/msaa_3d.mobile=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.web="gl_compatibility"

[threading]

worker_pool/max_threads=1

[input_devices]

buffering/agile_event_flushing=true
